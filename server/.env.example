# ============================================
# CẤU HÌNH SERVER & DATABASE
# ============================================
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<database_name>
JWT_SECRET=your_jwt_secret_key_here

# ============================================
# CẤU HÌNH CLOUDINARY (LƯU TRỮ HÌNH ẢNH)
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ============================================
# CẤU HÌNH GIAO HÀNG NHANH (GHN) - MÔI TRƯỜNG THỬ NGHIỆM STAGING
# ============================================
# Endpoint chính thức của GHN Staging (API V2)
GHN_API_URL=https://dev-online-gateway.ghn.vn/shiip/public-api

# Token API của tài khoản GHN Staging (Lấy tại https://khachhang.ghn.vn hoặc môi trường Staging)
GHN_TOKEN=your_ghn_staging_token_here

# Shop ID trên hệ thống GHN (Lưu ý: Lấy đúng Shop ID trong danh sách Shop của bạn, không nhầm với Client ID)
GHN_SHOP_ID=your_ghn_shop_id_here

# Mã Quận/Huyện của kho xuất hàng (Ví dụ: 1446 là Quận 4, TP.HCM)
GHN_FROM_DISTRICT_ID=1446

# Mã Phường/Xã của kho xuất hàng (Ví dụ: 20415 là Phường 18, Quận 4, TP.HCM)
GHN_FROM_WARD_CODE=20415

# ============================================
# CẤU HÌNH GMAIL SMTP (GỬI EMAIL OTP & XÁC NHẬN ĐƠN HÀNG)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=baohainao2016@gmail.com
# Mật khẩu ứng dụng Google (App Password 16 chữ số tạo tại myaccount.google.com/apppasswords)
SMTP_PASS=your_google_app_password_here
SMTP_FROM_NAME=MBBC

